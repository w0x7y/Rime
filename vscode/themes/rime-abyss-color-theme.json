		"type.defaultLibrary": "#4fb4dc",
		"variable.defaultLibrary": "#4fb4dc",
		"function.defaultLibrary": "#4fb4dc",
		"selfKeyword": "#4fb4dc",
		"parameter": "#c2cde0",
		"variable": "#c2cde0",
		"property": "#c2cde0",
		"enumMember": "#d4aaff",
		"function": "#6b9cf4",
		"method": "#6b9cf4",
		"macro": "#4fb4dc",
