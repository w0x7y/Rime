	"tokenColors": [
		{
			"name": "Comments",
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": {
				"foreground": "#6b768c",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Doc comment tags",
			"scope": [
				"comment.block.documentation storage.type",
				"comment.block.documentation entity.name.type"
			],
			"settings": {
				"foreground": "#9aa4b6",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Variables",
			"scope": [
				"variable",
				"variable.other.readwrite",
				"variable.other.object",
				"meta.definition.variable"
			],
			"settings": {
				"foreground": "#c2cde0"
			}
		},
		{
			"name": "Parameters",
			"scope": ["variable.parameter"],
			"settings": {
				"foreground": "#c2cde0"
			}
		},
		{
			"name": "Properties",
			"scope": [
				"variable.other.property",
				"variable.other.object.property"
			],
			"settings": {
				"foreground": "#c2cde0"
			}
		},
		{
			"name": "Builtin variables",
			"scope": [
				"variable.language",
				"support.variable",
				"variable.language.this",
				"variable.language.self",
				"variable.language.super"
			],
			"settings": {
				"foreground": "#4fb4dc"
			}
		},
		{
			"name": "JSON, YAML and CSS keys",
			"scope": [
				"support.type.property-name",
				"entity.name.tag.yaml",
				"support.type.property-name.json"
			],
			"settings": {
				"foreground": "#e8879f"
			}
		},
		{
			"name": "Strings",
			"scope": [
				"string",
				"punctuation.definition.string",
				"string.quoted",
				"string.template"
			],
			"settings": {
				"foreground": "#6fd0a8"
			}
		},
		{
			"name": "Inline code",
			"scope": ["markup.inline.raw"],
			"settings": {
				"foreground": "#6fd0a8"
			}
		},
		{
			"name": "Symbols",
			"scope": ["constant.other.symbol", "constant.language.symbol"],
			"settings": {
				"foreground": "#d4aaff"
			}
		},
		{
			"name": "Escapes",
			"scope": [
				"constant.character.escape",
				"constant.character.format.placeholder"
			],
			"settings": {
				"foreground": "#4fb4dc"
			}
		},
		{
			"name": "Regex",
			"scope": ["string.regexp", "constant.other.character-class"],
			"settings": {
				"foreground": "#4fb4dc"
			}
		},
		{
			"name": "Embedded expression brackets",
			"scope": [
				"punctuation.definition.template-expression",
				"punctuation.section.embedded"
			],
			"settings": {
				"foreground": "#4fb4dc"
			}
		},
		{
			"name": "Numbers",
			"scope": [
				"constant.numeric",
				"constant.other.color",
				"keyword.other.unit",
				"constant.character"
			],
			"settings": {
				"foreground": "#d4aaff"
			}
		},
		{
			"name": "Booleans",
			"scope": ["constant.language.boolean"],
			"settings": {
				"foreground": "#d4aaff"
			}
		},
		{
			"name": "Constants",
			"scope": [
				"constant.other",
				"variable.other.constant.property",
				"entity.name.constant",
				"support.constant",
				"variable.other.enummember"
			],
			"settings": {
				"foreground": "#d4aaff"
			}
		},
		{
			"name": "null, undefined and builtins",
			"scope": [
				"constant.language",
				"support.constant.math",
				"support.constant.json"
			],
			"settings": {
				"foreground": "#4fb4dc"
			}
		},
		{
			"name": "Functions",
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call.generic",
				"variable.function",
				"entity.name.method"
			],
			"settings": {
				"foreground": "#6b9cf4"
			}
		},
		{
			"name": "Macros",
			"scope": [
				"entity.name.function.macro",
				"entity.name.function.preprocessor"
			],
			"settings": {
				"foreground": "#4fb4dc"
			}
		},
		{
			"name": "Decorators and attributes",
			"scope": [
				"meta.decorator",
				"punctuation.decorator",
				"entity.name.function.decorator",
				"meta.attribute",
				"entity.other.attribute-name.pragma"
			],
			"settings": {
				"foreground": "#4fb4dc"
			}
		},
		{
			"name": "Types",
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"entity.name.struct",
				"entity.name.enum",
				"entity.name.interface",
				"entity.name.trait",
				"entity.other.inherited-class",
				"entity.name.type.class",
				"support.type",
				"support.class"
			],
			"settings": {
				"foreground": "#9cf0dc"
			}
		},
		{
			"name": "Modules",
			"scope": [
				"entity.name.namespace",
				"entity.name.type.module",
				"entity.name.scope-resolution"
			],
			"settings": {
				"foreground": "#9cf0dc"
			}
		},
		{
			"name": "Builtin types",
			"scope": [
				"support.type.primitive",
				"support.type.builtin",
				"keyword.type",
				"storage.type.primitive",
				"storage.type.built-in",
				"support.class.builtin",
				"support.class.promise",
				"support.class.console"
			],
			"settings": {
				"foreground": "#4fb4dc"
			}
		},
		{
			"name": "Keywords",
			"scope": [
				"keyword",
				"storage.type",
				"keyword.control",
				"keyword.operator.new",
				"keyword.operator.expression",
				"keyword.operator.logical.python",
				"keyword.other",
				"storage.type.function.arrow"
			],
			"settings": {
				"foreground": "#937ff2"
			}
		},
		{
			"name": "Modifiers",
			"scope": ["storage.modifier"],
			"settings": {
				"foreground": "#937ff2"
			}
		},
		{
			"name": "Imports",
			"scope": [
				"keyword.control.import",
				"keyword.control.export",
				"keyword.control.from"
			],
			"settings": {
				"foreground": "#937ff2"
			}
		},
		{
			"name": "Conditionals",
			"scope": [
				"keyword.control.conditional",
				"keyword.control.switch",
				"keyword.control.case",
				"keyword.control.else",
				"keyword.control.if"
			],
			"settings": {
				"foreground": "#e8879f",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Loops",
			"scope": [
				"keyword.control.loop",
				"keyword.control.for",
				"keyword.control.while",
				"keyword.control.do",
				"keyword.control.repeat",
				"keyword.control.break",
				"keyword.control.continue",
				"keyword.operator.expression.of"
			],
			"settings": {
				"foreground": "#9cf0dc"
			}
		},
		{
			"name": "Returns",
			"scope": ["keyword.control.return", "keyword.control.flow"],
			"settings": {
				"foreground": "#e8879f"
			}
		},
		{
			"name": "Exceptions",
			"scope": [
				"keyword.control.trycatch",
				"keyword.control.exception",
				"keyword.control.throw",
				"keyword.control.try",
				"keyword.control.catch",
				"keyword.control.finally"
			],
			"settings": {
