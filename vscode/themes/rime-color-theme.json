  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6b768c",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc comment tags",
      "scope": [
        "comment.block.documentation storage.type",
        "comment.block.documentation entity.name.type"
      ],
      "settings": {
        "foreground": "#9aa4b6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "variable.other.object",
        "variable.parameter",
        "meta.definition.variable",
        "variable.other.property",
        "variable.other.object.property"
      ],
      "settings": {
        "foreground": "#c3ccd9"
      }
    },
    {
      "name": "Builtin variables",
      "scope": [
        "variable.language",
        "support.variable",
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#7cc4d0"
      }
    },
    {
      "name": "JSON, YAML and CSS keys",
      "scope": [
        "support.type.property-name",
        "entity.name.tag.yaml",
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#d98a9c"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "string.quoted",
        "string.template",
        "markup.inline.raw",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#9ad8ac"
      }
    },
    {
      "name": "Escapes and regex",
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "constant.other.character-class",
        "constant.character.format.placeholder",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#7cc4d0"
      }
    },
    {
      "name": "Numbers and booleans",
      "scope": [
        "constant.numeric",
        "constant.language.boolean",
        "constant.other.color",
        "keyword.other.unit",
        "constant.character"
      ],
      "settings": {
        "foreground": "#e8a8cc"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant.other",
        "variable.other.constant.property",
        "entity.name.constant",
        "support.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#e8a8cc"
      }
    },
    {
      "name": "null, undefined and builtins",
      "scope": [
        "constant.language",
        "support.constant.math",
        "support.constant.json"
      ],
      "settings": {
        "foreground": "#7cc4d0"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "variable.function",
        "entity.name.method"
      ],
      "settings": {
        "foreground": "#7aa4e4"
      }
    },
    {
      "name": "Macros and decorators",
      "scope": [
        "entity.name.function.macro",
        "entity.name.function.preprocessor",
        "meta.decorator",
        "punctuation.decorator",
        "entity.name.function.decorator",
        "meta.attribute",
        "entity.other.attribute-name.pragma"
      ],
      "settings": {
        "foreground": "#7cc4d0"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.interface",
        "entity.name.trait",
        "entity.other.inherited-class",
        "entity.name.type.class",
        "support.type",
        "support.class",
        "entity.name.namespace",
        "entity.name.type.module",
        "entity.name.scope-resolution"
      ],
      "settings": {
        "foreground": "#e4d098"
      }
    },
    {
      "name": "Builtin types",
      "scope": [
        "support.type.primitive",
        "support.type.builtin",
        "keyword.type",
        "storage.type.primitive",
        "storage.type.built-in",
        "support.class.builtin",
        "support.class.promise",
        "support.class.console"
      ],
      "settings": {
        "foreground": "#7cc4d0"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.other",
        "storage.type.function.arrow"
      ],
      "settings": {
        "foreground": "#bb98d6"
      }
    },
    {
      "name": "Conditionals",
      "scope": [
        "keyword.control.conditional",
        "keyword.control.switch",
        "keyword.control.case",
        "keyword.control.else",
        "keyword.control.if"
      ],
      "settings": {
        "foreground": "#d98a9c",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Loops",
      "scope": [
        "keyword.control.loop",
        "keyword.control.for",
        "keyword.control.while",
        "keyword.control.do",
        "keyword.control.repeat",
        "keyword.control.break",
        "keyword.control.continue",
        "keyword.operator.expression.of"
      ],
      "settings": {
        "foreground": "#e4d098"
      }
    },
    {
      "name": "Return and exceptions",
      "scope": [
        "keyword.control.return",
        "keyword.control.flow",
        "keyword.control.trycatch",
        "keyword.control.exception",
        "keyword.control.throw",
        "keyword.control.try",
        "keyword.control.catch",
        "keyword.control.finally"
      ],
      "settings": {
        "foreground": "#d98a9c"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#9aa4b6"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.definition.block",
        "punctuation.definition.parameters",
        "punctuation.definition.array",
        "punctuation.definition.dictionary",
        "punctuation.section",
        "punctuation.definition.tag",
        "meta.tag.sgml"
      ],
      "settings": {
        "foreground": "#7987a1"
      }
    },
    {
      "name": "Template and string interpolation brackets",
      "scope": [
        "punctuation.definition.template-expression.begin",
        "punctuation.definition.template-expression.end",
        "punctuation.section.interpolation"
      ],
      "settings": {
        "foreground": "#7cc4d0"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "support.class.component",
        "entity.name.tag.html"
      ],
      "settings": {
        "foreground": "#d98a9c"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html",
        "entity.other.attribute-name.jsx"
      ],
      "settings": {
        "foreground": "#e4d098"
      }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.name.tag.css"
      ],
      "settings": {
        "foreground": "#e4d098"
      }
    },
    {
      "name": "CSS pseudo",
      "scope": [
        "entity.other.attribute-name.pseudo-class",
        "entity.other.attribute-name.pseudo-element"
      ],
      "settings": {
        "foreground": "#bb98d6"
      }
    },
    {
      "name": "CSS values",
      "scope": [
        "support.constant.property-value",
        "support.constant.font-name"
      ],
      "settings": {
        "foreground": "#7cc4d0"
      }
    },
    {
      "name": "Labels",
      "scope": [
        "entity.name.label",
        "punctuation.definition.label"
      ],
      "settings": {
        "foreground": "#e4d098"
      }
    },
    {
      "name": "Lifetimes",
      "scope": [
        "entity.name.type.lifetime",
        "storage.modifier.lifetime"
      ],
      "settings": {
        "foreground": "#e8a8cc",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Headings",
      "scope": [
        "markup.heading",
        "entity.name.section",
        "markup.heading entity.name"
      ],
      "settings": {
        "foreground": "#7aa4e4",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strikethrough",
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Links",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "constant.other.reference.link"
      ],
      "settings": {
        "foreground": "#7aa4e4"
      }
    },
    {
      "name": "Quotes",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#9aa4b6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Lists",
      "scope": [
        "markup.list punctuation.definition.list",
        "punctuation.definition.list.begin.markdown"
      ],
      "settings": {
        "foreground": "#d98a9c"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file"
      ],
      "settings": {
        "foreground": "#9ad8ac"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file"
      ],
      "settings": {
        "foreground": "#d98a9c"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#7aa4e4"
      }
    },
    {
      "name": "Diff ranges",
      "scope": [
        "meta.diff.range",
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#bb98d6"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#d98a9c",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#9aa4b6",
        "fontStyle": "strikethrough"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#e4d098",
    "type": "#e4d098",
    "class": "#e4d098",
    "enum": "#e4d098",
    "interface": "#e4d098",
    "struct": "#e4d098",
    "typeParameter": "#e4d098",
    "builtinType": "#7cc4d0",
    "class.defaultLibrary": "#7cc4d0",
    "type.defaultLibrary": "#7cc4d0",
    "variable.defaultLibrary": "#7cc4d0",
    "selfKeyword": "#7cc4d0",
    "parameter": "#c3ccd9",
    "variable": "#c3ccd9",
    "property": "#c3ccd9",
    "enumMember": "#e8a8cc",
    "function": "#7aa4e4",
    "method": "#7aa4e4",
    "macro": "#7cc4d0",
    "decorator": "#7cc4d0",
    "lifetime": {
      "foreground": "#e8a8cc",
      "italic": true
    },
    "*.deprecated": {
      "strikethrough": true
    }
  }
}
