	"tokenColors": [
		{
			"name": "Comments",
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": {
				"foreground": "#6b768c",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Doc comment tags",
			"scope": [
				"comment.block.documentation storage.type",
				"comment.block.documentation entity.name.type"
			],
			"settings": {
				"foreground": "#9aa4b6",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Variables",
			"scope": [
				"variable",
				"variable.other.readwrite",
				"variable.other.object",
				"meta.definition.variable"
			],
			"settings": {
				"foreground": "#c8d2e2"
			}
		},
		{
			"name": "Parameters",
			"scope": ["variable.parameter"],
			"settings": {
				"foreground": "#c8d2e2"
			}
		},
		{
			"name": "Properties",
			"scope": [
				"variable.other.property",
				"variable.other.object.property"
			],
			"settings": {
				"foreground": "#c8d2e2"
			}
		},
		{
			"name": "Builtin variables",
			"scope": [
				"variable.language",
				"support.variable",
				"variable.language.this",
				"variable.language.self",
				"variable.language.super"
			],
			"settings": {
				"foreground": "#38dce8"
			}
		},
		{
			"name": "JSON, YAML and CSS keys",
			"scope": [
				"support.type.property-name",
				"entity.name.tag.yaml",
				"support.type.property-name.json"
			],
			"settings": {
				"foreground": "#ff6f91"
			}
		},
		{
			"name": "Strings",
			"scope": [
				"string",
				"punctuation.definition.string",
				"string.quoted",
				"string.template"
			],
			"settings": {
				"foreground": "#5ef0a6"
			}
		},
		{
			"name": "Inline code",
			"scope": ["markup.inline.raw"],
			"settings": {
				"foreground": "#5ef0a6"
			}
		},
		{
			"name": "Symbols",
			"scope": ["constant.other.symbol", "constant.language.symbol"],
			"settings": {
				"foreground": "#ff8fe0"
			}
		},
		{
			"name": "Escapes",
			"scope": [
				"constant.character.escape",
				"constant.character.format.placeholder"
			],
			"settings": {
				"foreground": "#38dce8"
			}
		},
		{
			"name": "Regex",
			"scope": ["string.regexp", "constant.other.character-class"],
			"settings": {
				"foreground": "#38dce8"
			}
		},
		{
			"name": "Embedded expression brackets",
			"scope": [
				"punctuation.definition.template-expression",
				"punctuation.section.embedded"
			],
			"settings": {
				"foreground": "#38dce8"
			}
		},
		{
			"name": "Numbers",
			"scope": [
				"constant.numeric",
				"constant.other.color",
				"keyword.other.unit",
				"constant.character"
			],
			"settings": {
				"foreground": "#ff8fe0"
			}
		},
		{
			"name": "Booleans",
			"scope": ["constant.language.boolean"],
			"settings": {
				"foreground": "#ff8fe0"
			}
		},
		{
			"name": "Constants",
			"scope": [
				"constant.other",
				"variable.other.constant.property",
				"entity.name.constant",
				"support.constant",
				"variable.other.enummember"
			],
			"settings": {
				"foreground": "#ff8fe0"
			}
		},
		{
			"name": "null, undefined and builtins",
			"scope": [
				"constant.language",
				"support.constant.math",
				"support.constant.json"
			],
			"settings": {
				"foreground": "#38dce8"
			}
		},
		{
			"name": "Functions",
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call.generic",
				"variable.function",
				"entity.name.method"
			],
			"settings": {
				"foreground": "#4fa2ff"
			}
		},
		{
			"name": "Macros",
			"scope": [
				"entity.name.function.macro",
				"entity.name.function.preprocessor"
			],
			"settings": {
				"foreground": "#38dce8"
			}
		},
		{
			"name": "Decorators and attributes",
			"scope": [
				"meta.decorator",
				"punctuation.decorator",
				"entity.name.function.decorator",
				"meta.attribute",
				"entity.other.attribute-name.pragma"
			],
			"settings": {
				"foreground": "#38dce8"
			}
		},
		{
			"name": "Types",
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"entity.name.struct",
				"entity.name.enum",
				"entity.name.interface",
				"entity.name.trait",
				"entity.other.inherited-class",
				"entity.name.type.class",
				"support.type",
				"support.class"
			],
			"settings": {
				"foreground": "#e6f07c"
			}
		},
		{
			"name": "Modules",
			"scope": [
				"entity.name.namespace",
				"entity.name.type.module",
				"entity.name.scope-resolution"
			],
			"settings": {
				"foreground": "#e6f07c"
			}
		},
		{
			"name": "Builtin types",
			"scope": [
				"support.type.primitive",
				"support.type.builtin",
				"keyword.type",
				"storage.type.primitive",
				"storage.type.built-in",
				"support.class.builtin",
				"support.class.promise",
				"support.class.console"
			],
			"settings": {
				"foreground": "#38dce8"
			}
		},
		{
			"name": "Keywords",
			"scope": [
				"keyword",
				"storage.type",
				"keyword.control",
				"keyword.operator.new",
				"keyword.operator.expression",
				"keyword.operator.logical.python",
				"keyword.other",
				"storage.type.function.arrow"
			],
			"settings": {
				"foreground": "#9b7dff"
			}
		},
		{
			"name": "Modifiers",
			"scope": ["storage.modifier"],
			"settings": {
				"foreground": "#9b7dff"
			}
		},
		{
			"name": "Imports",
			"scope": [
				"keyword.control.import",
				"keyword.control.export",
				"keyword.control.from"
			],
			"settings": {
				"foreground": "#9b7dff"
			}
		},
		{
			"name": "Conditionals",
			"scope": [
				"keyword.control.conditional",
				"keyword.control.switch",
				"keyword.control.case",
				"keyword.control.else",
				"keyword.control.if"
			],
			"settings": {
				"foreground": "#ff6f91",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Loops",
			"scope": [
				"keyword.control.loop",
				"keyword.control.for",
				"keyword.control.while",
				"keyword.control.do",
				"keyword.control.repeat",
				"keyword.control.break",
				"keyword.control.continue",
				"keyword.operator.expression.of"
			],
			"settings": {
				"foreground": "#e6f07c"
			}
		},
		{
			"name": "Returns",
			"scope": ["keyword.control.return", "keyword.control.flow"],
			"settings": {
				"foreground": "#ff6f91"
			}
		},
		{
			"name": "Exceptions",
			"scope": [
				"keyword.control.trycatch",
				"keyword.control.exception",
				"keyword.control.throw",
				"keyword.control.try",
				"keyword.control.catch",
				"keyword.control.finally"
			],
			"settings": {
				"foreground": "#ff6f91"
			}
		},
		{
			"name": "Operators",
			"scope": [
				"keyword.operator",
				"punctuation.accessor",
				"punctuation.separator.key-value"
			],
			"settings": {
				"foreground": "#9aa4b6"
			}
		},
		{
			"name": "Punctuation",
			"scope": [
				"punctuation",
				"meta.brace",
				"punctuation.separator",
				"punctuation.terminator",
				"punctuation.definition.block",
				"punctuation.definition.parameters",
				"punctuation.definition.array",
				"punctuation.definition.dictionary",
				"punctuation.section",
				"punctuation.definition.tag",
				"meta.tag.sgml"
			],
			"settings": {
				"foreground": "#7084b7"
			}
		},
		{
			"name": "Template and string interpolation brackets",
			"scope": [
				"punctuation.definition.template-expression.begin",
				"punctuation.definition.template-expression.end",
				"punctuation.section.interpolation"
			],
			"settings": {
				"foreground": "#38dce8"
			}
		},
		{
			"name": "Tags",
			"scope": [
				"entity.name.tag",
				"support.class.component",
				"entity.name.tag.html"
			],
			"settings": {
				"foreground": "#ff6f91"
			}
		},
		{
			"name": "Attributes",
			"scope": [
				"entity.other.attribute-name",
				"entity.other.attribute-name.html",
				"entity.other.attribute-name.jsx"
			],
			"settings": {
				"foreground": "#e6f07c"
			}
		},
		{
			"name": "CSS selectors",
			"scope": [
				"entity.other.attribute-name.class.css",
				"entity.other.attribute-name.id.css",
				"entity.name.tag.css"
			],
			"settings": {
				"foreground": "#e6f07c"
			}
		},
		{
			"name": "CSS pseudo",
			"scope": [
				"entity.other.attribute-name.pseudo-class",
				"entity.other.attribute-name.pseudo-element"
			],
			"settings": {
				"foreground": "#9b7dff"
			}
		},
		{
			"name": "CSS values",
			"scope": [
				"support.constant.property-value",
				"support.constant.font-name"
			],
			"settings": {
				"foreground": "#38dce8"
			}
		},
		{
			"name": "Labels",
			"scope": ["entity.name.label", "punctuation.definition.label"],
			"settings": {
				"foreground": "#e6f07c"
			}
		},
		{
			"name": "Lifetimes",
			"scope": ["entity.name.type.lifetime", "storage.modifier.lifetime"],
			"settings": {
				"foreground": "#ff8fe0",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Headings",
			"scope": [
				"markup.heading",
				"entity.name.section",
				"markup.heading entity.name"
			],
			"settings": {
				"foreground": "#4fa2ff",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Bold",
			"scope": ["markup.bold"],
			"settings": {
				"fontStyle": "bold"
			}
		},
		{
			"name": "Italic",
			"scope": ["markup.italic"],
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"name": "Strikethrough",
			"scope": ["markup.strikethrough"],
			"settings": {
				"fontStyle": "strikethrough"
			}
		},
		{
			"name": "Link URLs",
			"scope": ["markup.underline.link"],
			"settings": {
				"foreground": "#4fa2ff",
				"fontStyle": "underline"
			}
		},
		{
			"name": "Link text",
			"scope": ["string.other.link", "constant.other.reference.link"],
			"settings": {
				"foreground": "#38dce8"
			}
		},
		{
			"name": "Quotes",
			"scope": ["markup.quote"],
			"settings": {
				"foreground": "#9aa4b6",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Lists",
			"scope": [
				"markup.list punctuation.definition.list",
				"punctuation.definition.list.begin.markdown"
			],
			"settings": {
				"foreground": "#ff6f91"
			}
		},
		{
			"name": "Diff inserted",
			"scope": ["markup.inserted", "meta.diff.header.to-file"],
			"settings": {
				"foreground": "#5ef0a6"
			}
		},
		{
			"name": "Diff deleted",
			"scope": ["markup.deleted", "meta.diff.header.from-file"],
			"settings": {
				"foreground": "#ff6f91"
			}
		},
		{
			"name": "Diff changed",
			"scope": ["markup.changed"],
			"settings": {
				"foreground": "#4fa2ff"
			}
		},
		{
			"name": "Diff ranges",
			"scope": ["meta.diff.range", "meta.diff.header"],
			"settings": {
				"foreground": "#9b7dff"
			}
		},
		{
			"name": "Invalid",
			"scope": ["invalid", "invalid.illegal"],
			"settings": {
				"foreground": "#ff6f91",
				"fontStyle": "underline"
			}
		},
		{
			"name": "Deprecated",
			"scope": ["invalid.deprecated"],
			"settings": {
				"foreground": "#9aa4b6",
				"fontStyle": "strikethrough"
			}
		}
	],
	"semanticTokenColors": {
		"namespace": "#e6f07c",
		"type": "#e6f07c",
		"class": "#e6f07c",
		"enum": "#e6f07c",
		"interface": "#e6f07c",
		"struct": "#e6f07c",
		"typeParameter": "#e6f07c",
		"builtinType": "#38dce8",
		"class.defaultLibrary": "#38dce8",
		"type.defaultLibrary": "#38dce8",
		"variable.defaultLibrary": "#38dce8",
		"function.defaultLibrary": "#38dce8",
		"selfKeyword": "#38dce8",
		"parameter": "#c8d2e2",
		"variable": "#c8d2e2",
		"property": "#c8d2e2",
		"enumMember": "#ff8fe0",
		"function": "#4fa2ff",
		"method": "#4fa2ff",
		"macro": "#38dce8",
		"decorator": "#38dce8",
		"lifetime": {
			"foreground": "#ff8fe0",
			"italic": true
		},
		"*.deprecated": {
			"strikethrough": true
		}
	}
}
