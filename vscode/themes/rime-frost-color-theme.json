	"tokenColors": [
		{
			"name": "Comments",
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": {
				"foreground": "#7f899b",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Doc comment tags",
			"scope": [
				"comment.block.documentation storage.type",
				"comment.block.documentation entity.name.type"
			],
			"settings": {
				"foreground": "#566073",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Variables",
			"scope": [
				"variable",
				"variable.other.readwrite",
				"variable.other.object",
				"meta.definition.variable"
			],
			"settings": {
				"foreground": "#363d4a"
			}
		},
		{
			"name": "Parameters",
			"scope": ["variable.parameter"],
			"settings": {
				"foreground": "#363d4a"
			}
		},
		{
			"name": "Properties",
			"scope": [
				"variable.other.property",
				"variable.other.object.property"
			],
			"settings": {
				"foreground": "#363d4a"
			}
		},
		{
			"name": "Builtin variables",
			"scope": [
				"variable.language",
				"support.variable",
				"variable.language.this",
				"variable.language.self",
				"variable.language.super"
			],
			"settings": {
				"foreground": "#0f7480"
			}
		},
		{
			"name": "JSON, YAML and CSS keys",
			"scope": [
				"support.type.property-name",
				"entity.name.tag.yaml",
				"support.type.property-name.json"
			],
			"settings": {
				"foreground": "#b83d63"
			}
		},
		{
			"name": "Strings",
			"scope": [
				"string",
				"punctuation.definition.string",
				"string.quoted",
				"string.template"
			],
			"settings": {
				"foreground": "#267b4f"
			}
		},
		{
			"name": "Inline code",
			"scope": ["markup.inline.raw"],
			"settings": {
				"foreground": "#267b4f"
			}
		},
		{
			"name": "Symbols",
			"scope": ["constant.other.symbol", "constant.language.symbol"],
			"settings": {
				"foreground": "#a34396"
			}
		},
		{
			"name": "Escapes",
			"scope": [
				"constant.character.escape",
				"constant.character.format.placeholder"
			],
			"settings": {
				"foreground": "#0f7480"
			}
		},
		{
			"name": "Regex",
			"scope": ["string.regexp", "constant.other.character-class"],
			"settings": {
				"foreground": "#0f7480"
			}
		},
		{
			"name": "Embedded expression brackets",
			"scope": [
				"punctuation.definition.template-expression",
				"punctuation.section.embedded"
			],
			"settings": {
				"foreground": "#0f7480"
			}
		},
		{
			"name": "Numbers",
			"scope": [
				"constant.numeric",
				"constant.other.color",
				"keyword.other.unit",
				"constant.character"
			],
			"settings": {
				"foreground": "#a34396"
			}
		},
		{
			"name": "Booleans",
			"scope": ["constant.language.boolean"],
			"settings": {
				"foreground": "#a34396"
			}
		},
		{
			"name": "Constants",
			"scope": [
				"constant.other",
				"variable.other.constant.property",
				"entity.name.constant",
				"support.constant",
				"variable.other.enummember"
			],
			"settings": {
				"foreground": "#a34396"
			}
		},
		{
			"name": "null, undefined and builtins",
			"scope": [
				"constant.language",
				"support.constant.math",
				"support.constant.json"
			],
			"settings": {
				"foreground": "#0f7480"
			}
		},
		{
			"name": "Functions",
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call.generic",
				"variable.function",
				"entity.name.method"
			],
			"settings": {
				"foreground": "#2e62c0"
			}
		},
		{
			"name": "Macros",
			"scope": [
				"entity.name.function.macro",
				"entity.name.function.preprocessor"
			],
			"settings": {
				"foreground": "#0f7480"
			}
		},
		{
			"name": "Decorators and attributes",
			"scope": [
				"meta.decorator",
				"punctuation.decorator",
				"entity.name.function.decorator",
				"meta.attribute",
				"entity.other.attribute-name.pragma"
			],
			"settings": {
				"foreground": "#0f7480"
			}
		},
		{
			"name": "Types",
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"entity.name.struct",
				"entity.name.enum",
				"entity.name.interface",
				"entity.name.trait",
				"entity.other.inherited-class",
				"entity.name.type.class",
				"support.type",
				"support.class"
			],
			"settings": {
				"foreground": "#866405"
			}
		},
		{
			"name": "Modules",
			"scope": [
				"entity.name.namespace",
				"entity.name.type.module",
				"entity.name.scope-resolution"
			],
			"settings": {
				"foreground": "#866405"
			}
		},
		{
			"name": "Builtin types",
			"scope": [
				"support.type.primitive",
				"support.type.builtin",
				"keyword.type",
				"storage.type.primitive",
				"storage.type.built-in",
				"support.class.builtin",
				"support.class.promise",
				"support.class.console"
			],
			"settings": {
				"foreground": "#0f7480"
			}
		},
		{
			"name": "Keywords",
			"scope": [
				"keyword",
				"storage.type",
				"keyword.control",
				"keyword.operator.new",
				"keyword.operator.expression",
				"keyword.operator.logical.python",
				"keyword.other",
				"storage.type.function.arrow"
			],
			"settings": {
				"foreground": "#7650c4"
			}
		},
		{
			"name": "Modifiers",
			"scope": ["storage.modifier"],
			"settings": {
				"foreground": "#7650c4"
			}
		},
		{
			"name": "Imports",
			"scope": [
				"keyword.control.import",
				"keyword.control.export",
				"keyword.control.from"
			],
			"settings": {
				"foreground": "#7650c4"
			}
		},
		{
			"name": "Conditionals",
			"scope": [
				"keyword.control.conditional",
				"keyword.control.switch",
				"keyword.control.case",
				"keyword.control.else",
				"keyword.control.if"
			],
			"settings": {
				"foreground": "#b83d63",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Loops",
			"scope": [
				"keyword.control.loop",
				"keyword.control.for",
				"keyword.control.while",
				"keyword.control.do",
				"keyword.control.repeat",
				"keyword.control.break",
				"keyword.control.continue",
				"keyword.operator.expression.of"
			],
			"settings": {
				"foreground": "#866405"
			}
		},
		{
			"name": "Returns",
			"scope": ["keyword.control.return", "keyword.control.flow"],
			"settings": {
				"foreground": "#b83d63"
			}
		},
		{
			"name": "Exceptions",
			"scope": [
				"keyword.control.trycatch",
				"keyword.control.exception",
				"keyword.control.throw",
				"keyword.control.try",
				"keyword.control.catch",
				"keyword.control.finally"
			],
			"settings": {
				"foreground": "#b83d63"
			}
		},
		{
			"name": "Operators",
			"scope": [
				"keyword.operator",
				"punctuation.accessor",
				"punctuation.separator.key-value"
			],
			"settings": {
				"foreground": "#566073"
			}
		},
		{
			"name": "Punctuation",
			"scope": [
				"punctuation",
				"meta.brace",
				"punctuation.separator",
				"punctuation.terminator",
				"punctuation.definition.block",
				"punctuation.definition.parameters",
				"punctuation.definition.array",
				"punctuation.definition.dictionary",
				"punctuation.section",
				"punctuation.definition.tag",
				"meta.tag.sgml"
			],
			"settings": {
				"foreground": "#5f7090"
			}
		},
		{
			"name": "Template and string interpolation brackets",
			"scope": [
				"punctuation.definition.template-expression.begin",
				"punctuation.definition.template-expression.end",
				"punctuation.section.interpolation"
			],
			"settings": {
				"foreground": "#0f7480"
			}
		},
		{
			"name": "Tags",
			"scope": [
				"entity.name.tag",
				"support.class.component",
				"entity.name.tag.html"
			],
			"settings": {
				"foreground": "#b83d63"
			}
		},
		{
			"name": "Attributes",
			"scope": [
				"entity.other.attribute-name",
				"entity.other.attribute-name.html",
				"entity.other.attribute-name.jsx"
			],
			"settings": {
				"foreground": "#866405"
			}
		},
		{
			"name": "CSS selectors",
			"scope": [
				"entity.other.attribute-name.class.css",
				"entity.other.attribute-name.id.css",
				"entity.name.tag.css"
			],
			"settings": {
				"foreground": "#866405"
			}
		},
		{
			"name": "CSS pseudo",
			"scope": [
				"entity.other.attribute-name.pseudo-class",
				"entity.other.attribute-name.pseudo-element"
			],
			"settings": {
				"foreground": "#7650c4"
			}
		},
		{
			"name": "CSS values",
			"scope": [
				"support.constant.property-value",
				"support.constant.font-name"
			],
			"settings": {
				"foreground": "#0f7480"
			}
		},
		{
			"name": "Labels",
			"scope": ["entity.name.label", "punctuation.definition.label"],
			"settings": {
				"foreground": "#866405"
			}
		},
		{
			"name": "Lifetimes",
			"scope": ["entity.name.type.lifetime", "storage.modifier.lifetime"],
			"settings": {
				"foreground": "#a34396",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Headings",
			"scope": [
				"markup.heading",
				"entity.name.section",
				"markup.heading entity.name"
			],
			"settings": {
				"foreground": "#2e62c0",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Bold",
			"scope": ["markup.bold"],
			"settings": {
				"fontStyle": "bold"
			}
		},
		{
			"name": "Italic",
			"scope": ["markup.italic"],
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"name": "Strikethrough",
			"scope": ["markup.strikethrough"],
			"settings": {
				"fontStyle": "strikethrough"
			}
		},
		{
			"name": "Link URLs",
			"scope": ["markup.underline.link"],
			"settings": {
				"foreground": "#2e62c0",
				"fontStyle": "underline"
			}
		},
		{
			"name": "Link text",
			"scope": ["string.other.link", "constant.other.reference.link"],
			"settings": {
				"foreground": "#0f7480"
			}
		},
		{
			"name": "Quotes",
			"scope": ["markup.quote"],
			"settings": {
				"foreground": "#566073",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Lists",
			"scope": [
				"markup.list punctuation.definition.list",
				"punctuation.definition.list.begin.markdown"
			],
			"settings": {
				"foreground": "#b83d63"
			}
		},
		{
			"name": "Diff inserted",
			"scope": ["markup.inserted", "meta.diff.header.to-file"],
			"settings": {
				"foreground": "#267b4f"
			}
		},
		{
			"name": "Diff deleted",
			"scope": ["markup.deleted", "meta.diff.header.from-file"],
			"settings": {
				"foreground": "#b83d63"
			}
		},
		{
			"name": "Diff changed",
			"scope": ["markup.changed"],
			"settings": {
				"foreground": "#2e62c0"
			}
		},
		{
			"name": "Diff ranges",
			"scope": ["meta.diff.range", "meta.diff.header"],
			"settings": {
				"foreground": "#7650c4"
			}
		},
		{
			"name": "Invalid",
			"scope": ["invalid", "invalid.illegal"],
			"settings": {
				"foreground": "#b83d63",
				"fontStyle": "underline"
			}
		},
		{
			"name": "Deprecated",
			"scope": ["invalid.deprecated"],
			"settings": {
				"foreground": "#566073",
				"fontStyle": "strikethrough"
			}
		}
	],
	"semanticTokenColors": {
		"namespace": "#866405",
		"type": "#866405",
		"class": "#866405",
		"enum": "#866405",
		"interface": "#866405",
		"struct": "#866405",
		"typeParameter": "#866405",
		"builtinType": "#0f7480",
		"class.defaultLibrary": "#0f7480",
		"type.defaultLibrary": "#0f7480",
		"variable.defaultLibrary": "#0f7480",
		"function.defaultLibrary": "#0f7480",
		"selfKeyword": "#0f7480",
		"parameter": "#363d4a",
		"variable": "#363d4a",
		"property": "#363d4a",
		"enumMember": "#a34396",
		"function": "#2e62c0",
		"method": "#2e62c0",
		"macro": "#0f7480",
		"decorator": "#0f7480",
		"lifetime": {
			"foreground": "#a34396",
			"italic": true
		},
		"*.deprecated": {
			"strikethrough": true
		}
	}
}
